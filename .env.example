# Переменные проверяет src/shared/config/env-schema.ts при старте сервера.
# Ошибка в значении останавливает запуск, а не всплывает на первом запросе.

# --- Рантайм (читаются при каждом запуске, в образ не вшиваются) ---

# Адрес API бэкенда, http или https. Обязателен.
BACKEND_URL=http://127.0.0.1:8010

# Канонический адрес сайта для canonical, Open Graph, sitemap и JSON-LD.
# Пусто — адрес берётся из заголовков запроса (только для разработки).
# Обязателен, если INDEXING_ENABLED=true в продакшене.
# SITE_URL=https://example.com

# Публичные страницы закрыты от индекса. Открыть для поиска: true. Допустимо только true или false.
INDEXING_ENABLED=false

# --- Сборка (Next вшивает NEXT_PUBLIC_* в клиентский бандл на этапе next build) ---

# DSN проекта Sentry (платформа Next.js). Им можно только отправлять события, не читать их.
# NEXT_PUBLIC_SENTRY_DSN=

# Загрузка source maps. Эти три значения не коммитить: токен читает чужие ошибки.
# В Docker токен передаётся как build secret, а не build-arg.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=